<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Teruskan header Authorization (Bearer JWT) ke PHP pada Apache / LiteSpeed Hostinger
  CGIPassAuth On
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Arahkan seluruh request /api dan /api/* ke router PHP
  RewriteRule ^api/?$ api/index.php [QSA,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Jangan ubah request untuk file atau direktori statis yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback SPA React Router (/admin, /admin/login, /berita/...) ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Lindungi file sensitif
<FilesMatch "^(\.env|\.user\.ini|\.ftp-deploy-sync-state\.json|config\.php|config\.example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
